# Copier ce fichier en .env puis remplir les valeurs. NE PAS versionner .env

# ── Base de données Supabase (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql://postgres.xxxxxxxx:[MOT_DE_PASSE]@aws-0-xx.pooler.supabase.com:5432/postgres

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=changez_moi_chaine_aleatoire_longue
JWT_EXPIRATION=1d

# ── IA (OpenRouter) ───────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-votre_cle
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ── Emails (SMTP Gmail) ───────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=votre.adresse@gmail.com
MAIL_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM="ExoCraft" <votre.adresse@gmail.com>

# ── URLs ──────────────────────────────────────────────────────────────────────
# En prod : FRONTEND_URL = URL Vercel  (ex: https://exocraft.vercel.app)
FRONTEND_URL=http://localhost:5173
PORT=3000

# ── Google Forms (facultatif) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ═══════════════════════════════════════════════════════════════════════════════
# SECRETS GITHUB ACTIONS — à configurer dans :
# ton repo GitHub → Settings → Secrets and variables → Actions
# ═══════════════════════════════════════════════════════════════════════════════

# ── Railway (Backend) ─────────────────────────────────────────────────────────
# RAILWAY_TOKEN      = Token d'API Railway (railway.app → Account → API Tokens)

# ── Vercel (Frontend) ─────────────────────────────────────────────────────────
# VERCEL_TOKEN       = Token Vercel (vercel.com → Settings → Tokens)
# VERCEL_ORG_ID      = ID de ton équipe/compte Vercel  (vercel.com → Settings)
# VERCEL_PROJECT_ID  = ID du projet Vercel (Vercel project → Settings → General)

# ── Variables GitHub (pas secrets) ───────────────────────────────────────────
# VITE_API_URL       = URL Railway du backend  (ex: https://exocraft-backend.up.railway.app)
#                      À mettre aussi dans Vercel → Project → Environment Variables
