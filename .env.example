# Copier ce fichier en .env puis remplir les valeurs. NE PAS versionner .env

# --- Base de données Supabase (PostgreSQL) ---
# Supabase > Connect > "Session pooler" (compatible IPv4). Remplacer [MOT_DE_PASSE].
DATABASE_URL=postgresql://postgres.xxxxxxxx:[MOT_DE_PASSE]@aws-0-xx.pooler.supabase.com:5432/postgres

# --- JWT ---
JWT_SECRET=changez_moi_chaine_aleatoire_longue
JWT_EXPIRATION=1d

# --- IA (le backend refuse de démarrer si cette clé est vide) ---
OPENROUTER_API_KEY=mettre_une_cle_ou_une_valeur_bidon
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# --- Google Forms (facultatif) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FRONTEND_URL=http://localhost

# --- Paiement (Mode simulé / Mock) ---
# Aucune clé externe requise en mode développement.
# Le système utilise JWT_SECRET pour signer les tokens de paiement.
# Pour passer en production avec Konnect, ajouter :
# KONNECT_API_KEY=...
# KONNECT_WALLET_ID=...
